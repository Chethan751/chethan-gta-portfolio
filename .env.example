# Server-side Environment Variables for Chethan S AI Talking Portfolio
# Set these in the Vercel Dashboard under Project Settings -> Environment Variables.
# IMPORTANT: Never commit actual secret keys to Git or expose them in client-side VITE_ variables!

# Required: Your OpenRouter API Key (sk-or-v1-...)
OPENROUTER_API_KEY=replace_with_your_server_side_key

# Optional: Preferred OpenRouter Model ID (defaults to meta-llama/llama-3.3-70b-instruct:free if omitted)
# Recommended options:
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemini-2.0-flash-lite:free
# - deepseek/deepseek-chat
# - anthropic/claude-3.5-haiku
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
